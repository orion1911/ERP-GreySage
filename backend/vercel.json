{
 "version": 2,
 "builds": [
  {
   "src": "server.js",
   "use": "@vercel/node",
   "config": { "includeFiles": ["dist/**"], "maxDuration": 60 }
  }
 ],
 "routes": [
  {
   "src": "/(.*)",
   "dest": "server.js"
  }
 ],
 "crons": [
  {
   "path": "/api/cron/low-stock-digest",
   "schedule": "30 3 * * *"
  },
  {
   "path": "/api/cron/makings-recon",
   "schedule": "0 2 * * *"
  }
 ]
}